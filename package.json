{
  "name": "@tenwise/engine",
  "private": true,
  "version": "0.1.3",
  "description": "Tenwise Engine: a local-first feed reader with cited AI summaries that run on your own machine. No account, no cloud.",
  "license": "AGPL-3.0-only",
  "author": "CodeStrata, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tenwise/tenwise-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Tenwise/tenwise-engine/issues"
  },
  "homepage": "https://github.com/Tenwise/tenwise-engine#readme",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "imports": {
    "#tenwise-plugins": "./src/plugins/none.js"
  },
  "scripts": {
    "predev": "node scripts/check-node.js",
    "dev": "concurrently --kill-others \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js --dev",
    "start": "npm run build -- --logLevel warn && node server/index.js",
    "prebuild": "node scripts/check-node.js",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "service": "scripts/service.sh",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.20",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "docx": "^9.11.0",
    "dompurify": "^3.4.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "marked": "^18.0.14",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
